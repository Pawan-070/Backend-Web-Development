generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A member of the community platform.
model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts     Post[]
  comments  Comment[]
  votes     Vote[]
  following Follow[]  @relation("Follower")
  followers Follow[]  @relation("Following")

  @@index([createdAt])
  @@map("users")
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  body      String   @default("")
  authorId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Deleting an author removes the posts they wrote.
  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  comments Comment[]
  votes    Vote[]
  tags     PostTag[]

  // Demonstrated lookup paths: list a user's posts, newest posts first.
  @@index([authorId])
  @@index([createdAt])
  @@map("posts")
}

model Comment {
  id        Int      @id @default(autoincrement())
  body      String
  postId    Int
  authorId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A comment cannot outlive its post or its author.
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([postId, createdAt])
  @@index([authorId])
  @@map("comments")
}

model Vote {
  id        Int      @id @default(autoincrement())
  // 1 for upvote, -1 for downvote.
  value     Int      @default(1)
  userId    Int
  postId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // A user may hold only one vote per post.
  @@unique([userId, postId])
  @@index([postId])
  @@map("votes")
}

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // The same follow edge cannot be recorded twice.
  @@unique([followerId, followingId])
  // Listing who a user follows and who follows them.
  @@index([followingId])
  @@index([followerId])
  @@map("follows")
}

model Tag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  posts PostTag[]

  @@map("tags")
}

// Explicit join model so a tag cannot be attached to the same post twice.
model PostTag {
  postId Int
  tagId  Int

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tags")
}
